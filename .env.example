ADMIN_IDS=YOUR_TELEGRAM_USER_ID

# ═══ اختیاری ═══
MAX_DURATION_MIN=15
MAX_FILE_MB=35
DB_PATH=/data/music_bot.db

# برای زمانی که YouTube روی سرور بلاک باشه
