# ═══ اجباری ═══
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
ADMIN_IDS=YOUR_TELEGRAM_USER_ID

# ═══ اختیاری ═══
DB_PATH=/data/music_bot.db

# محدودیت‌ها
MAX_DURATION_MIN=15
# سقف حجم فایل صوتی (مگابایت) — پیش از ارسال بررسی می‌شود
MAX_FILE_MB=35
# سقف حجم ویدیو (مگابایت) — سقف تلگرام برای آپلود ربات ۵۰ است
MAX_VIDEO_MB=50

# منطقه زمانی مرز ریست محدودیت روزانه (۳ کلیک/ویدیو در روز)
BOT_TZ=Asia/Tehran

# حداکثر دانلود همزمان yt-dlp (بیشتر = سریع‌تر، ولی مصرف رم بالاتر)
YTDL_CONCURRENCY=4

# برای زمانی که YouTube روی سرور بلاک باشه
# COOKIES_FILE=/app/cookies.txt
# YT_PROXY=socks5://user:pass@host:1080

# فعال/غیرفعال کردن منابع
ENABLE_AVALAND=1
ENABLE_AUDIUS=1
ENABLE_PIPED=1
ENABLE_ARCHIVE=1
